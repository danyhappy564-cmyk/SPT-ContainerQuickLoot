<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageRestore>
    <add key="enabled" value="True" />
    <add key="automatic" value="True" />
  </packageRestore>
  <activePackageSource>
    <add key="All" value="(Aggregate source)" />
  </activePackageSource>
  <packageSources>
    <!--
      The BepInEx feed (nuget.bepinex.dev) is gone along with the BepInEx.Core package
      it served. BepInEx now comes from the SPT install, so nothing here needs that
      source - and leaving it in makes every restore reach for a host the build no
      longer depends on, which fails outright on a machine that cannot see it.
    -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
