<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.1, matching SPT 4.1 client plugins. This was net472. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>CactusPie.ContainerQuickLoot</RootNamespace>
    <AssemblyName>CactusPie.ContainerQuickLoot</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Version>1.9.0</Version>
    <Company>CactusPie</Company>
    <Product>CactusPie.ContainerQuickLoot</Product>

    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!--
    References come from a real SPT install rather than the repository's libs\ folder,
    which held 4.0 copies. Building against those produced a plugin compiled for types
    4.1 no longer has, and did so QUIETLY - a 4.0 Assembly-CSharp resolves every name in
    this project without complaint.

    BepInEx comes from the install too, replacing the BepInEx.Core NuGet package. That
    package needs nuget.bepinex.dev, so the build failed outright anywhere that feed is
    unreachable, and the version it pinned had no particular relationship to the BepInEx
    the game actually loads this plugin into.
  -->
  <PropertyGroup>
    <SptRoot Condition=" '$(SptRoot)' == '' ">E:\SPT 4.1</SptRoot>
    <SptManaged>$(SptRoot)\EscapeFromTarkov_Data\Managed</SptManaged>
    <SptBepInEx>$(SptRoot)\BepInEx</SptBepInEx>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(SptBepInEx)\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(SptBepInEx)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="spt-reflection">
      <HintPath>$(SptBepInEx)\plugins\spt\spt-reflection.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SptManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(SptManaged)\Comfort.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Comfort.Unity">
      <HintPath>$(SptManaged)\Comfort.Unity.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ItemComponent.Types">
      <HintPath>$(SptManaged)\ItemComponent.Types.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(SptManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SptManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(SptManaged)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="EnsureSptRoot" BeforeTargets="BeforeBuild;ResolveAssemblyReferences">
    <Error Condition="!Exists('$(SptManaged)\Assembly-CSharp.dll')"
           Text="SptRoot '$(SptRoot)' does not look like an SPT install (missing EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll). Pass -p:SptRoot=... or set the SptRoot environment variable." />
    <Error Condition="!Exists('$(SptBepInEx)\plugins\spt\spt-reflection.dll')"
           Text="SptRoot '$(SptRoot)' has no BepInEx\plugins\spt\spt-reflection.dll. The mod cannot be stamped with an SPT version without it." />
  </Target>

  <!--
    SPT's launcher decides which version a plugin was "built for" by reading the version of the
    spt-reflection assembly it references, and refuses to start the game on a mismatch. Building
    against a placeholder copy of that dll therefore produces a plugin that compiles, loads under
    Harmony, and is then rejected at launch with "built for SPT 1.0.0" - a failure that shows up
    nowhere until someone tries to play. Fail the build instead.
  -->
  <Target Name="EnsureRealSptReflection" AfterTargets="EnsureSptRoot" BeforeTargets="BeforeBuild;ResolveAssemblyReferences">
    <GetAssemblyIdentity AssemblyFiles="$(SptBepInEx)\plugins\spt\spt-reflection.dll">
      <Output TaskParameter="Assemblies" ItemName="_SptReflectionIdentity" />
    </GetAssemblyIdentity>
    <Error Condition="'%(_SptReflectionIdentity.Version)' == '1.0.0.0'"
           Text="spt-reflection.dll under SptRoot '$(SptRoot)' reports version 1.0.0.0, which is a placeholder rather than a real SPT install. A plugin built against it is rejected by the launcher as 'built for SPT 1.0.0'. Point SptRoot at an actual SPT installation." />
    <Message Text="spt-reflection %(_SptReflectionIdentity.Version) - plugin will be stamped for that SPT version." Importance="high" />
  </Target>

  <Target Name="CopyToSPT" AfterTargets="Build" Condition="Exists('$(SptRoot)')">
    <MakeDir Directories="$(SptBepInEx)\plugins" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SptBepInEx)\plugins" />
  </Target>

  <!-- Staging one level down so the archive is never inside what it is archiving. -->
  <PropertyGroup>
    <ReleaseDir>$(ProjectDir)..\Release</ReleaseDir>
    <ReleaseStagingDir>$(ReleaseDir)\staging</ReleaseStagingDir>
  </PropertyGroup>

  <!--
    The zip used to contain the dll and nothing else. This mod is GPL-3.0, and that licence
    requires its text to travel with every copy handed to someone else - so a binary-only
    archive was not a distributable artefact. LICENSE and NOTICE.txt now ship inside it,
    NOTICE naming the original author and pointing at the source the GPL obliges us to make
    available.
  -->
  <Target Name="PackageRelease" AfterTargets="CopyToSPT">
    <RemoveDir Directories="$(ReleaseStagingDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ReleaseStagingDir)\BepInEx\plugins" />
    <Copy SourceFiles="$(ProjectDir)..\LICENSE;$(ProjectDir)NOTICE.txt"
          DestinationFolder="$(ReleaseStagingDir)" />
    <ZipDirectory SourceDirectory="$(ReleaseStagingDir)"
                  DestinationFile="$(ReleaseDir)\CactusPie.ContainerQuickLoot.zip"
                  Overwrite="true" />
    <Message Text="Release zip: $(ReleaseDir)\CactusPie.ContainerQuickLoot.zip" Importance="high" />
  </Target>

</Project>
